{
  "name": "@vise/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev",
    "build": "vue-tsc --noEmit && vp build",
    "preview": "vp preview",
    "typecheck": "vue-tsc --noEmit -p tsconfig.json",
    "test": "vp test run",
    "arch:generate": "node ../../scripts/generate-configs.ts",
    "arch:depcruise": "depcruise src --config .dependency-cruiser.cjs --ignore-known",
    "arch:graph": "depcruise src --config .dependency-cruiser.cjs --output-type dot",
    "arch:baseline": "depcruise-baseline src --config .dependency-cruiser.cjs",
    "arch:baseline:check": "node ../../scripts/check-baseline-size.ts",
    "arch:module-count": "node ../../scripts/check-module-count.ts",
    "arch:no-disable": "node ../../scripts/check-no-disable-comments.ts",
    "verify:enforcement": "node ../../scripts/verify-enforcement.ts"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^4.0.2",
    "reka-ui": "^2.10.1",
    "tailwind-merge": "^3.6.0",
    "vue": "^3.5.40",
    "vue-router": "^5.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "catalog:",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/compiler-sfc": "^3.5.40",
    "dependency-cruiser": "^18.1.0",
    "msw": "^2.15.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.2",
    "vite": "catalog:",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vue-tsc": "^3.3.8"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
