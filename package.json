{
  "name": "vise",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vp dev apps/web",
    "build": "vp run -r build",
    "fmt": "vp fmt",
    "lint": "vp lint",
    "check": "vp check",
    "test": "vp run -r test",
    "arch:generate": "vp run --filter ./apps/web arch:generate",
    "arch:graph": "node scripts/render-graph.ts",
    "verify:enforcement": "vp run --filter ./apps/web verify:enforcement",
    "ready": "vp fmt && vp lint && vp run -r test && vp run -r build",
    "prepare": "vp config"
  },
  "devDependencies": {
    "@viz-js/viz": "catalog:",
    "plop": "catalog:",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "packageManager": "pnpm@11.17.0"
}
